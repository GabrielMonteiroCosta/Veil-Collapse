# ── Banco de dados PostgreSQL (Neon) ─────────────────────────────────────────
# Copie a connection string do painel do Neon em: seu projeto → Dashboard → Connection string
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── JWT ──────────────────────────────────────────────────────────────────────
# Gere uma string aleatória segura: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_string_longa_e_aleatoria

# ── Resend (e-mail para reset de senha) ──────────────────────────────────────
# Crie uma API Key em: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── URL pública do site (usada nos links de e-mail) ──────────────────────────
# Em produção: https://seusite.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
